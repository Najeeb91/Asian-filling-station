<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b5ed7">
<title>Asian Filling Station v0.5 — Pilot</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f4f7fb;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
header{background:#0b5ed7;color:#fff;padding:22px 16px;border-radius:0 0 22px 22px}
.wrap{max-width:900px;margin:auto;padding:0 14px}
h1{font-size:21px;margin:0 0 4px}
.sub{opacity:.85;font-size:13px}
.cards{display:flex;gap:8px;margin-top:16px}
.card{flex:1;background:#ffffff22;padding:11px;border-radius:12px;font-size:12px}
.card b{display:block;font-size:18px;margin-top:4px}
main{padding:16px 0 60px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.btn{border:0;border-radius:10px;padding:10px 14px;font-weight:700;font-size:13px;cursor:pointer}
.primary{background:#0b5ed7;color:#fff}
.white{background:#fff;border:1px solid #dfe4ec;color:#172033}
.danger{background:#fff;border:1px solid #f0b7b7;color:#a61b1b}
.panel{background:#fff;border-radius:15px;padding:15px;box-shadow:0 2px 12px #00000008}
.search{width:100%;padding:11px;border:1px solid #dfe4ec;border-radius:10px;font-size:14px;margin:8px 0 12px}
table{width:100%;border-collapse:collapse}
th,td{padding:10px 5px;border-bottom:1px solid #edf0f4;font-size:13px;text-align:left}
.right{text-align:right}
.name{font-weight:700;cursor:pointer}
.owe{color:#b42318;font-weight:800}
.empty{text-align:center;color:#70798a;padding:25px}
.modal{display:none;position:fixed;inset:0;background:#0008;align-items:flex-end;z-index:1000}
.modal.open{display:flex}
.sheet{background:#fff;width:100%;max-width:700px;margin:auto;border-radius:20px 20px 0 0;padding:18px;max-height:94vh;overflow:auto;position:relative}
.close{float:right;border:0;border-radius:50%;width:34px;height:34px;font-size:20px;cursor:pointer}
.field{margin:10px 0}
.field label{display:block;font-size:12px;color:#687386;margin-bottom:4px}
.field input,.field select,.field textarea{width:100%;padding:10px;border:1px solid #dfe4ec;border-radius:10px;font-size:14px;font-family:inherit}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.calc{background:#f0f6ff;border-radius:12px;padding:12px;margin:10px 0}
.amount{font-size:22px;font-weight:800;margin-top:2px}
.meta{font-size:12px;color:#687386}
.filter-bar{background:#f8fafc;padding:10px;border-radius:10px;margin-bottom:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px}
.ledger-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
.ledger-table{min-width:650px}
.row-actions{display:flex;gap:4px;justify-content:flex-end}
.row-actions .btn{padding:6px 8px;font-size:12px}

@media print {
  body * { visibility: hidden; }
  #statementArea, #statementArea * { visibility: visible; }
  #statementArea { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; }
  .no-print { display: none !important; }
}
</style>
</head>
<body>

<header class="no-print">
  <div class="wrap">
    <h1>⛽ Asian Filling Station</h1>
    <div class="sub">Customer Ledger • v0.5 Stable Pilot (Steps 5A–5E Complete)</div>
    <div class="cards">
      <div class="card">Customers<b id="count">0</b></div>
      <div class="card">Receivable<b id="receivable">₹0</b></div>
      <div class="card">Transactions<b id="entries">0</b></div>
    </div>
  </div>
</header>

<main class="wrap no-print">
  <div class="actions">
    <button class="btn primary" onclick="openCustomerModal()">+ Customer</button>
    <button class="btn primary" onclick="openFuel()">⛽ Fuel Sale</button>
    <button class="btn primary" onclick="openPayment()">💰 Payment</button>
    <button class="btn white" onclick="practice()">Practice Data</button>
    <button class="btn danger" onclick="resetData()">🔄 Reset Data</button>
  </div>
  <section class="panel">
    <h2>Customer Accounts</h2>
    <input class="search" id="search" placeholder="🔍 Search customer name, phone, or vehicle..." oninput="render()">
    <div id="list"></div>
  </section>
</main>

<!-- Customer Modal (Add/Edit Step 5A) -->
<div class="modal" id="customerModal"><div class="sheet">
  <button class="close" onclick="closeM('customerModal')">×</button>
  <h2 id="custModalTitle">Add Customer</h2>
  <input type="hidden" id="editCustId">
  <div class="field"><label>Customer / Party Name</label><input id="cname" placeholder="Ravi Transport"></div>
  <div class="grid">
    <div class="field"><label>Mobile Phone</label><input id="phone" inputmode="tel" placeholder="98XXXXXXXX"></div>
    <div class="field"><label>Vehicle Number</label><input id="vehicle" placeholder="HR 55 AB 1234"></div>
  </div>
  <div class="grid">
    <div class="field"><label>Customer Type</label>
      <select id="ctype"><option>Transporter</option><option>Company</option><option>Individual</option><option>Other</option></select>
    </div>
    <div class="field"><label>Credit Limit ₹</label><input id="limit" type="number" min="0" value="0"></div>
  </div>
  <div class="field" id="openingField"><label>Opening Balance ₹</label><input id="opening" type="number" min="0" value="0"></div>
  <div class="field"><label>Customer Notes</label><textarea id="cnotes" rows="2" placeholder="Preferred billing terms, notes..."></textarea></div>
  <button class="btn primary" onclick="saveCustomer()">Save Customer Profile</button>
</div></div>

<!-- Fuel Modal -->
<div class="modal" id="fuelModal"><div class="sheet">
  <button class="close" onclick="closeM('fuelModal')">×</button>
  <h2>⛽ Record Fuel Sale</h2>
  <div class="field"><label>Sale Date</label><input id="fdate" type="date"></div>
  <div class="field"><label>Customer</label><select id="fcustomer" onchange="checkCredit()"></select></div>
  <div class="grid">
    <div class="field"><label>Fuel Type</label><select id="fuel" onchange="checkCredit()"><option value="Diesel">Diesel</option><option value="Petrol">Petrol</option></select></div>
    <div class="field"><label>Payment Type</label><select id="pay" onchange="checkCredit()"><option value="credit">Credit</option><option value="cash">Cash</option><option value="upi">UPI</option><option value="card">Card</option></select></div>
  </div>
  <div class="grid">
    <div class="field"><label>Quantity (litres)</label><input id="litres" type="number" min="0" step="0.01" oninput="calc();checkCredit()"></div>
    <div class="field"><label>Rate ₹/litre</label><input id="rate" type="number" min="0" step="0.01" oninput="calc();checkCredit()"></div>
  </div>
  <div class="calc">Automatic Amount<div class="amount" id="amount">₹0.00</div></div>
  <div class="calc" id="creditStatus">Select customer and enter sales data.</div>
  <div class="field"><label>Description / Remarks</label><input id="desc" placeholder="Fuel credit sale"></div>
  <button class="btn primary" onclick="saveFuel()">Save Fuel Sale</button>
</div></div>

<!-- Payment Modal (Step 5D) -->
<div class="modal" id="payModal"><div class="sheet">
  <button class="close" onclick="closeM('payModal')">×</button>
  <h2>💰 Payment Received</h2>
  <div class="field"><label>Payment Date</label><input id="pdate" type="date"></div>
  <div class="field"><label>Customer</label><select id="pcustomer"></select></div>
  <div class="field"><label>Amount ₹</label><input id="pamount" type="number" min="0" step="0.01"></div>
  <div class="field"><label>Payment Mode</label>
    <select id="pmode"><option>Cash</option><option>UPI</option><option>Bank Transfer</option><option>Cheque</option><option>Card</option></select>
  </div>
  <div class="field"><label>Reference / Cheque / UTR No.</label><input id="pref" placeholder="Ref/Cheque/UTR number"></div>
  <div class="field"><label>Notes</label><input id="pnotes" placeholder="Payment remarks"></div>
  <button class="btn primary" onclick="savePayment()">Save Payment</button>
</div></div>

<!-- Edit Transaction Modal -->
<div class="modal" id="editModal"><div class="sheet">
  <button class="close" onclick="closeM('editModal')">×</button>
  <h2>✏️ Edit Transaction</h2>
  <div class="field"><label>Date</label><input id="edate" type="date"></div>
  <div class="field"><label>Customer</label><select id="ecustomer"></select></div>
  <div class="field"><label>Transaction Type</label>
    <select id="etype" onchange="toggleEditFields()"><option value="fuel">Fuel Sale</option><option value="payment">Payment Received</option><option value="opening">Opening Balance</option></select>
  </div>
  <div id="efuelFields">
    <div class="grid">
      <div class="field"><label>Fuel</label><select id="efuel"><option>Diesel</option><option>Petrol</option></select></div>
      <div class="field"><label>Payment</label><select id="epay"><option value="credit">Credit</option><option value="cash">Cash</option><option value="upi">UPI</option><option value="card">Card</option></select></div>
    </div>
    <div class="grid">
      <div class="field"><label>Quantity (litres)</label><input id="elitres" type="number" min="0" step="0.01" oninput="editCalc()"></div>
      <div class="field"><label>Rate ₹/litre</label><input id="erate" type="number" min="0" step="0.01" oninput="editCalc()"></div>
    </div>
    <div class="calc">Automatic Amount<div class="amount" id="eamount">₹0.00</div></div>
  </div>
  <div id="epaymentFields" style="display:none">
    <div class="field"><label>Amount ₹</label><input id="eamountInput" type="number" min="0" step="0.01"></div>
    <div class="field"><label>Mode</label><select id="emode"><option>Cash</option><option>UPI</option><option>Bank Transfer</option><option>Cheque</option><option>Card</option></select></div>
    <div class="field"><label>Reference / Cheque No.</label><input id="eref"></div>
    <div class="field"><label>Notes</label><input id="enotes"></div>
  </div>
  <div id="eopeningFields" style="display:none">
    <div class="field"><label>Opening Balance ₹</label><input id="eopening" type="number" min="0" step="0.01"></div>
  </div>
  <div class="field"><label>Description</label><input id="edesc"></div>
  <button class="btn primary" onclick="saveEdit()">Save Changes</button>
</div></div>

<!-- Delete Confirmation Modal -->
<div class="modal" id="deleteModal"><div class="sheet">
  <button class="close" onclick="closeM('deleteModal')">×</button>
  <h2>⚠️ Delete Item</h2>
  <div class="calc"><div id="deleteInfo"></div></div>
  <p>Action cannot be undone. Outstanding balances will recalculate instantly.</p>
  <div class="actions">
    <button class="btn white" onclick="closeM('deleteModal')">Cancel</button>
    <button class="btn danger" onclick="confirmDelete()">🗑️ Confirm Delete</button>
  </div>
</div></div>

<!-- Ledger & Filtering Modal (Step 5B & 5C) -->
<div class="modal" id="ledgerModal"><div class="sheet">
  <button class="close" onclick="closeM('ledgerModal')">×</button>
  <h2 id="ltitle"></h2>
  <div id="lmeta" style="margin-bottom:8px"></div>
  
  <!-- Step 5B Filter Controls -->
  <div class="filter-bar no-print">
    <input type="date" id="fltStart" onchange="renderLedgerFiltered()">
    <input type="date" id="fltEnd" onchange="renderLedgerFiltered()">
    <select id="fltFuel" onchange="renderLedgerFiltered()"><option value="">All Fuels</option><option>Diesel</option><option>Petrol</option></select>
    <select id="fltType" onchange="renderLedgerFiltered()"><option value="">All Types</option><option value="credit">Credit Sale</option><option value="payment">Payment</option><option value="opening">Opening</option></select>
    <input id="fltQuery" placeholder="🔍 Search Tx..." oninput="renderLedgerFiltered()">
  </div>

  <div id="ledger"></div>
</div></div>

<!-- Customer Statement Modal (Step 5C) -->
<div class="modal" id="statementModal"><div class="sheet" style="max-width:800px">
  <button class="close no-print" onclick="closeM('statementModal')">×</button>
  <div class="actions no-print" style="float:right;margin-right:10px">
    <button class="btn primary" onclick="window.print()">🖨️ Print / Save PDF</button>
    <button class="btn white" onclick="exportCSV()">📥 Export CSV</button>
  </div>
  <div id="statementArea"></div>
</div></div>

<script>
const K = "afs_v05";
let db = JSON.parse(localStorage.getItem(K) || '{"customers":[],"tx":[]}');
let currentLedgerCid = null;
let deletingTarget = null; // {type: 'tx'|'cust', id: string}

const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2);
const money = n => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(n || 0);
const esc = s => String(s || "").replace(/[&<>"']/g, m => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m]));
const todayISO = () => new Date().toISOString().slice(0, 10);
const formatDate = s => s ? s.slice(0, 10).split("-").reverse().join("/") : "—";

function save() { localStorage.setItem(K, JSON.stringify(db)); render(); }

function bal(c) {
  return db.tx.filter(t => t.cid === c.id).reduce((x, t) => x + ((t.type === "credit" || t.type === "opening") ? t.amount : t.type === "payment" ? -t.amount : 0), 0);
}

// 5A Customer Profile & Main View
function render() {
  const q = (document.getElementById("search").value || "").toLowerCase();
  const cs = db.customers.filter(c => 
    c.name.toLowerCase().includes(q) || 
    (c.phone && c.phone.includes(q)) || 
    (c.vehicle && c.vehicle.toLowerCase().includes(q))
  );

  document.getElementById("count").textContent = db.customers.length;
  document.getElementById("entries").textContent = db.tx.length;
  document.getElementById("receivable").textContent = money(db.customers.reduce((s, c) => s + Math.max(0, bal(c)), 0));

  document.getElementById("list").innerHTML = cs.length ? `<table>
    <tr><th>Customer</th><th>Details</th><th class="right">Outstanding</th><th class="right">Actions</th></tr>
    ${cs.map(c => `<tr>
      <td class="name" onclick="openLedger('${c.id}')">${esc(c.name)}</td>
      <td class="meta">📱 ${esc(c.phone || "—")}<br>🚛 ${esc(c.vehicle || "—")} (${esc(c.type || "Other")})</td>
      <td class="right ${bal(c) > 0 ? "owe" : ""}">${money(bal(c))}</td>
      <td class="right">
        <button class="btn white" onclick="openCustomerModal('${c.id}')">✏️ Edit</button>
        <button class="btn danger" onclick="prepDelete('cust', '${c.id}')">🗑️</button>
      </td>
    </tr>`).join("")}</table>` : '<div class="empty">No matching customer records found.</div>';
}

function openCustomerModal(cid) {
  document.getElementById("editCustId").value = cid || "";
  if (cid) {
    const c = db.customers.find(x => x.id === cid);
    document.getElementById("custModalTitle").textContent = "✏️ Edit Customer Profile";
    document.getElementById("cname").value = c.name;
    document.getElementById("phone").value = c.phone || "";
    document.getElementById("vehicle").value = c.vehicle || "";
    document.getElementById("ctype").value = c.type || "Transporter";
    document.getElementById("limit").value = c.creditLimit || 0;
    document.getElementById("cnotes").value = c.notes || "";
    document.getElementById("openingField").style.display = "none";
  } else {
    document.getElementById("custModalTitle").textContent = "➕ Add Customer Profile";
    document.getElementById("cname").value = "";
    document.getElementById("phone").value = "";
    document.getElementById("vehicle").value = "";
    document.getElementById("ctype").value = "Transporter";
    document.getElementById("limit").value = 0;
    document.getElementById("opening").value = 0;
    document.getElementById("cnotes").value = "";
    document.getElementById("openingField").style.display = "block";
  }
  document.getElementById("customerModal").classList.add("open");
}

function saveCustomer() {
  const name = document.getElementById("cname").value.trim();
  if (!name) return alert("Please enter Customer / Party Name.");

  const cid = document.getElementById("editCustId").value;
  if (cid) {
    const c = db.customers.find(x => x.id === cid);
    c.name = name;
    c.phone = document.getElementById("phone").value.trim();
    c.vehicle = document.getElementById("vehicle").value.trim();
    c.type = document.getElementById("ctype").value;
    c.creditLimit = +document.getElementById("limit").value || 0;
    c.notes = document.getElementById("cnotes").value.trim();
  } else {
    const c = {
      id: uid(),
      name,
      phone: document.getElementById("phone").value.trim(),
      vehicle: document.getElementById("vehicle").value.trim(),
      type: document.getElementById("ctype").value,
      creditLimit: +document.getElementById("limit").value || 0,
      notes: document.getElementById("cnotes").value.trim()
    };
    db.customers.push(c);
    const o = +document.getElementById("opening").value || 0;
    if (o > 0) {
      db.tx.push({ id: uid(), cid: c.id, type: "opening", amount: o, desc: "Opening Balance", date: todayISO() + "T12:00:00" });
    }
  }
  save();
  closeM("customerModal");
  if (currentLedgerCid) openLedger(currentLedgerCid);
}

// Fuel & Payments Fill dropdowns
function fillDropdowns() {
  const opts = db.customers.map(c => `<option value="${c.id}">${esc(c.name)}${c.vehicle ? " (" + esc(c.vehicle) + ")" : ""}</option>`).join("");
  document.getElementById("fcustomer").innerHTML = opts;
  document.getElementById("pcustomer").innerHTML = opts;
}

function openFuel(cid) {
  if (!db.customers.length) return alert("Please add a customer profile first.");
  fillDropdowns();
  document.getElementById("fdate").value = todayISO();
  if (cid) document.getElementById("fcustomer").value = cid;
  checkCredit();
  document.getElementById("fuelModal").classList.add("open");
}

function calc() {
  const x = (+document.getElementById("litres").value || 0) * (+document.getElementById("rate").value || 0);
  document.getElementById("amount").textContent = money(x);
}

function checkCredit() {
  const el = document.getElementById("creditStatus");
  const cid = document.getElementById("fcustomer").value;
  const c = db.customers.find(x => x.id === cid);
  if (!c) return;
  const payment = document.getElementById("pay").value;
  const sale = (+document.getElementById("litres").value || 0) * (+document.getElementById("rate").value || 0);

  if (payment !== "credit") {
    el.textContent = "Cash/UPI/Card sale: credit limit is not affected.";
    return;
  }
  const current = Math.max(0, bal(c));
  const limit = +c.creditLimit || 0;
  const next = current + sale;

  if (!limit) {
    el.textContent = `No credit limit configured. Outstanding: ${money(current)}.`;
  } else if (next > limit) {
    el.innerHTML = `⚠️ <b>Credit limit exceeded</b><br>Limit: ${money(limit)} • Outstanding: ${money(current)} • New: ${money(next)}`;
  } else {
    el.innerHTML = `✅ Credit check OK<br>Limit: ${money(limit)} • Outstanding: ${money(current)} • Post Sale: ${money(next)}`;
  }
}

function saveFuel() {
  const cid = document.getElementById("fcustomer").value;
  const l = +document.getElementById("litres").value || 0;
  const r = +document.getElementById("rate").value || 0;
  const payType = document.getElementById("pay").value;
  if (l <= 0 || r <= 0) return alert("Quantity and rate must be greater than zero.");

  const amt = l * r;
  if (payType === "credit") {
    const c = db.customers.find(x => x.id === cid);
    const limit = +c.creditLimit || 0;
    const next = Math.max(0, bal(c)) + amt;
    if (limit && next > limit) {
      if (!confirm(`Credit limit exceeded!\nLimit: ${money(limit)}\nNew Outstanding: ${money(next)}\n\nProceed anyway?`)) return;
    }
  }

  db.tx.push({
    id: uid(), cid,
    type: payType === "credit" ? "credit" : "sale",
    amount: amt, l, r,
    fuel: document.getElementById("fuel").value,
    payment: payType,
    desc: document.getElementById("desc").value || "Fuel sale",
    date: (document.getElementById("fdate").value || todayISO()) + "T12:00:00"
  });
  save();
  closeM("fuelModal");
  if (currentLedgerCid === cid) openLedger(cid);
}

// 5D Payment Management
function openPayment(cid) {
  if (!db.customers.length) return alert("Please add a customer profile first.");
  fillDropdowns();
  document.getElementById("pdate").value = todayISO();
  if (cid) document.getElementById("pcustomer").value = cid;
  document.getElementById("payModal").classList.add("open");
}

function savePayment() {
  const cid = document.getElementById("pcustomer").value;
  const amt = +document.getElementById("pamount").value || 0;
  if (amt <= 0) return alert("Please enter valid payment amount.");

  db.tx.push({
    id: uid(), cid,
    type: "payment",
    amount: amt,
    mode: document.getElementById("pmode").value,
    ref: document.getElementById("pref").value.trim(),
    notes: document.getElementById("pnotes").value.trim(),
    desc: "Payment Received",
    date: (document.getElementById("pdate").value || todayISO()) + "T12:00:00"
  });
  save();
  closeM("payModal");
  if (currentLedgerCid === cid) openLedger(cid);
}

// 5B & 5C Ledger, Filtering & Statements
function openLedger(cid) {
  currentLedgerCid = cid;
  const c = db.customers.find(x => x.id === cid);
  document.getElementById("ltitle").textContent = c.name;
  document.getElementById("lmeta").innerHTML = `<div class="meta">
    📱 ${esc(c.phone || "—")} &nbsp; 🚛 ${esc(c.vehicle || "—")} &nbsp; 🏢 ${esc(c.type || "—")} &nbsp; 💳 Credit Limit: ${money(c.creditLimit || 0)}
    ${c.notes ? `<br>📝 <i>${esc(c.notes)}</i>` : ""}
  </div>`;

  // Reset filters
  document.getElementById("fltStart").value = "";
  document.getElementById("fltEnd").value = "";
  document.getElementById("fltFuel").value = "";
  document.getElementById("fltType").value = "";
  document.getElementById("fltQuery").value = "";

  renderLedgerFiltered();
  document.getElementById("ledgerModal").classList.add("open");
}

function renderLedgerFiltered() {
  if (!currentLedgerCid) return;
  const cid = currentLedgerCid;
  const c = db.customers.find(x => x.id === cid);

  const start = document.getElementById("fltStart").value;
  const end = document.getElementById("fltEnd").value;
  const fuel = document.getElementById("fltFuel").value;
  const type = document.getElementById("fltType").value;
  const q = document.getElementById("fltQuery").value.toLowerCase();

  let allTx = db.tx.filter(t => t.cid === cid).sort((a, b) => new Date(a.date) - new Date(b.date));

  let runningBal = 0;
  let rows = [];

  allTx.forEach(t => {
    const plus = (t.type === "credit" || t.type === "opening") ? t.amount : 0;
    const minus = t.type === "payment" ? t.amount : 0;
    runningBal += plus - minus;

    const tDate = t.date.slice(0, 10);
    if (start && tDate < start) return;
    if (end && tDate > end) return;
    if (fuel && t.fuel !== fuel) return;
    if (type && t.type !== type) return;
    
    const textSearch = `${t.desc} ${t.fuel || ""} ${t.mode || ""} ${t.ref || ""} ${t.notes || ""}`.toLowerCase();
    if (q && !textSearch.includes(q)) return;

    let details = t.l ? `${esc(t.fuel)} — ${t.l} L × ${money(t.r)}/L` : esc(t.desc);
    if (t.mode) details += `<br><small>Mode: ${esc(t.mode)}${t.ref ? " • Ref: " + esc(t.ref) : ""}${t.notes ? " • " + esc(t.notes) : ""}</small>`;

    rows.push(`<tr>
      <td>${formatDate(tDate)}</td>
      <td>${details}</td>
      <td>${plus ? money(plus) : "—"}</td>
      <td>${minus ? money(minus) : "—"}</td>
      <td><b>${money(runningBal)}</b></td>
      <td class="right no-print"><div class="row-actions">
        <button class="btn white" onclick="editTx('${t.id}')">✏️</button>
        <button class="btn danger" onclick="prepDelete('tx', '${t.id}')">🗑️</button>
      </div></td>
    </tr>`);
  });

  document.getElementById("ledger").innerHTML = `
    <div class="calc">Current Outstanding Balance<div class="amount">${money(bal(c))}</div></div>
    <div class="ledger-wrap">
      <table class="ledger-table">
        <tr><th>Date</th><th>Particulars</th><th>Debit (Sale)</th><th>Credit (Paid)</th><th>Running Balance</th><th class="right no-print">Actions</th></tr>
        ${rows.length ? rows.join("") : '<tr><td colspan="6" class="empty">No matching transactions.</td></tr>'}
      </table>
    </div><br>
    <div class="actions no-print">
      <button class="btn primary" onclick="closeM('ledgerModal');openFuel('${cid}')">⛽ Fuel Sale</button>
      <button class="btn primary" onclick="closeM('ledgerModal');openPayment('${cid}')">💰 Payment</button>
      <button class="btn white" onclick="openStatement('${cid}')">📑 View / Print Statement</button>
    </div>
  `;
}

// 5C Clean Customer Statement View
function openStatement(cid) {
  const c = db.customers.find(x => x.id === cid);
  const tx = db.tx.filter(t => t.cid === cid).sort((a, b) => new Date(a.date) - new Date(b.date));

  let running = 0;
  let totalDebit = 0;
  let totalCredit = 0;

  const rows = tx.map(t => {
    const debit = (t.type === "credit" || t.type === "opening") ? t.amount : 0;
    const credit = t.type === "payment" ? t.amount : 0;
    totalDebit += debit;
    totalCredit += credit;
    running += debit - credit;

    let desc = t.l ? `${t.fuel} (${t.l} L @ ${money(t.r)})` : t.desc;
    if (t.mode) desc += ` [${t.mode}${t.ref ? " Ref: " + t.ref : ""}]`;

    return `<tr>
      <td>${formatDate(t.date)}</td>
      <td>${esc(desc)}</td>
      <td class="right">${debit ? money(debit) : "—"}</td>
      <td class="right">${credit ? money(credit) : "—"}</td>
      <td class="right"><b>${money(running)}</b></td>
    </tr>`;
  }).join("");

  document.getElementById("statementArea").innerHTML = `
    <div style="border-bottom:2px solid #0b5ed7;padding-bottom:10px;margin-bottom:15px">
      <h2>⛽ Asian Filling Station</h2>
      <p style="margin:2px 0;font-size:13px">Customer Ledger Statement</p>
    </div>
    <div style="margin-bottom:15px;font-size:13px">
      <b>Customer:</b> ${esc(c.name)}<br>
      <b>Phone:</b> ${esc(c.phone || "N/A")} | <b>Vehicle:</b> ${esc(c.vehicle || "N/A")} | <b>Type:</b> ${esc(c.type || "N/A")}<br>
      <b>Statement Date:</b> ${formatDate(todayISO())}
    </div>
    <table>
      <thead><tr><th>Date</th><th>Particulars</th><th class="right">Debit (₹)</th><th class="right">Credit (₹)</th><th class="right">Balance (₹)</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
    <div style="margin-top:15px;text-align:right;font-size:14px">
      Total Debit: <b>${money(totalDebit)}</b> | Total Credit: <b>${money(totalCredit)}</b><br>
      <span style="font-size:18px">Closing Balance: <b class="owe">${money(running)}</b></span>
    </div>
  `;

  document.getElementById("statementModal").classList.add("open");
}

function exportCSV() {
  if (!currentLedgerCid) return;
  const c = db.customers.find(x => x.id === currentLedgerCid);
  const tx = db.tx.filter(t => t.cid === currentLedgerCid).sort((a, b) => new Date(a.date) - new Date(b.date));

  let csv = "Date,Particulars,Debit,Credit,Running Balance\n";
  let bal = 0;
  tx.forEach(t => {
    const d = (t.type === "credit" || t.type === "opening") ? t.amount : 0;
    const cr = t.type === "payment" ? t.amount : 0;
    bal += d - cr;
    const desc = (t.l ? `${t.fuel} - ${t.l}L` : t.desc).replace(/,/g, " ");
    csv += `${t.date.slice(0, 10)},"${desc}",${d},${cr},${bal}\n`;
  });

  const blob = new Blob([csv], { type: "text/csv" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = `Statement_${c.name.replace(/\s+/g, "_")}.csv`;
  a.click();
}

// Edit & Delete Handlers
function editTx(id) {
  const t = db.tx.find(x => x.id === id);
  if (!t) return;
  document.getElementById("edate").value = t.date.slice(0, 10);
  document.getElementById("ecustomer").innerHTML = db.customers.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join("");
  document.getElementById("ecustomer").value = t.cid;
  document.getElementById("edesc").value = t.desc || "";
  document.getElementById("etype").value = t.l ? "fuel" : (t.type === "payment" ? "payment" : "opening");

  if (t.l) {
    document.getElementById("efuel").value = t.fuel || "Diesel";
    document.getElementById("epay").value = t.payment || "credit";
    document.getElementById("elitres").value = t.l || 0;
    document.getElementById("erate").value = t.r || 0;
  } else if (t.type === "payment") {
    document.getElementById("eamountInput").value = t.amount || 0;
    document.getElementById("emode").value = t.mode || "Cash";
    document.getElementById("eref").value = t.ref || "";
    document.getElementById("enotes").value = t.notes || "";
  } else {
    document.getElementById("eopening").value = t.amount || 0;
  }

  toggleEditFields();
  editCalc();
  document.getElementById("editModal").classList.add("open");
  document.getElementById("editModal").dataset.txid = id;
}

function toggleEditFields() {
  const x = document.getElementById("etype").value;
  document.getElementById("efuelFields").style.display = x === "fuel" ? "block" : "none";
  document.getElementById("epaymentFields").style.display = x === "payment" ? "block" : "none";
  document.getElementById("eopeningFields").style.display = x === "opening" ? "block" : "none";
}

function editCalc() {
  const a = (+document.getElementById("elitres").value || 0) * (+document.getElementById("erate").value || 0);
  document.getElementById("eamount").textContent = money(a);
}

function saveEdit() {
  const id = document.getElementById("editModal").dataset.txid;
  const t = db.tx.find(x => x.id === id);
  if (!t) return;

  const type = document.getElementById("etype").value;
  t.cid = document.getElementById("ecustomer").value;
  t.date = (document.getElementById("edate").value || todayISO()) + "T12:00:00";
  t.desc = document.getElementById("edesc").value || "";

  if (type === "fuel") {
    const l = +document.getElementById("elitres").value || 0;
    const r = +document.getElementById("erate").value || 0;
    if (l <= 0 || r <= 0) return alert("Enter valid quantity and rate.");
    t.type = document.getElementById("epay").value === "credit" ? "credit" : "sale";
    t.l = l; t.r = r; t.amount = l * r;
    t.fuel = document.getElementById("efuel").value;
    t.payment = document.getElementById("epay").value;
  } else if (type === "payment") {
    const a = +document.getElementById("eamountInput").value || 0;
    if (a <= 0) return alert("Enter valid payment amount.");
    t.type = "payment"; t.amount = a;
    t.mode = document.getElementById("emode").value;
    t.ref = document.getElementById("eref").value.trim();
    t.notes = document.getElementById("enotes").value.trim();
  } else {
    const a = +document.getElementById("eopening").value || 0;
    t.type = "opening"; t.amount = a;
  }

  save();
  closeM("editModal");
  if (currentLedgerCid) renderLedgerFiltered();
}

function prepDelete(type, id) {
  deletingTarget = { type, id };
  if (type === "cust") {
    const c = db.customers.find(x => x.id === id);
    document.getElementById("deleteInfo").innerHTML = `<b>Delete Customer:</b> ${esc(c.name)}<br>All associated transaction records will be removed.`;
  } else {
    const t = db.tx.find(x => x.id === id);
    document.getElementById("deleteInfo").innerHTML = `<b>Delete Transaction:</b> ${esc(t.desc)}<br>Amount: ${money(t.amount)}`;
  }
  document.getElementById("deleteModal").classList.add("open");
}

function confirmDelete() {
  if (!deletingTarget) return;
  if (deletingTarget.type === "cust") {
    db.customers = db.customers.filter(c => c.id !== deletingTarget.id);
    db.tx = db.tx.filter(t => t.cid !== deletingTarget.id);
    if (currentLedgerCid === deletingTarget.id) closeM("ledgerModal");
  } else {
    db.tx = db.tx.filter(t => t.id !== deletingTarget.id);
  }
  save();
  closeM("deleteModal");
  if (currentLedgerCid) renderLedgerFiltered();
}

function closeM(id) { document.getElementById(id).classList.remove("open"); }

